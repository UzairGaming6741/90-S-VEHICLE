{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.com_crimson_vein_vault_oxpqcjcm.the_crimson_error.attack_bare_hand": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "is_bare_hand": "variable.is_holding_left != 1.0"
            }
          ]
        },
        "is_bare_hand": {
          "animations": ["zombie_attack_bare_hand"],
          "transitions": [
            {
              "default": "variable.is_holding_left == 1.0"
            }
          ]
        }
      }
    },
    "controller.animation.com_crimson_vein_vault_oxpqcjcm.the_crimson_error.swimming": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "is_swimming": "variable.swim_amount > 0.0"
            }
          ]
        },
        "is_swimming": {
          "animations": ["swimming"],
          "transitions": [
            {
              "default": "variable.swim_amount <= 0.0"
            }
          ]
        }
      }
    }
  }
}
