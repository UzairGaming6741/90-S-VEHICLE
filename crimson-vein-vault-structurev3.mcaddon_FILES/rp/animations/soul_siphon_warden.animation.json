            "(variable.is_brandishing_spear ? 0.0 : variable.attackbodyroty * 2.0) + variable.attackbodyroty",
            0.0
          ]
        }
      }
    },
    "animation.com_crimson_vein_vault_oxpqcjcm.soul_siphon_warden.move": {
      "anim_time_update": "query.modified_distance_moved",
