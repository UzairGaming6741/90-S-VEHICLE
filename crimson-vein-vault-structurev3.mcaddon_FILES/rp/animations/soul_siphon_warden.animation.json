          ]
        },
        "rightArm": {
          "rotation": [
            "query.is_charging ? (216.0 - this) : 0.0",
            0.0,
            0.0
          ]
        },
        "rightwing": {
          "position": [
            0.0,
            "-1.0 - this",
            "2.0 - this"
          ],
          "rotation": [
            "27.0 - this",
            "27.0 + math.cos(query.life_time * 916.8) * 9.0 - this",
            "27.0 - this"
          ]
        }
      }
    }
  }
}
